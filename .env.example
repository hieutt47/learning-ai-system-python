# Liveness works without database settings. Set secrets only for explicit DB commands/use cases.
APP_NAME=Learning AI System API
APP_ENVIRONMENT=development
DATABASE_URL=
# Official Flyway executable (absolute path recommended). No CLI is bundled or auto-installed.
FLYWAY_EXECUTABLE=
# Opt-in disposable MySQL tests only. Never point this at an existing application database.
RUN_MYSQL_TESTS=0
TEST_DATABASE_URL=
# Required for identity only: generate your own cryptographically random secret >=32 bytes.
# Empty means auth endpoints return safe 503 CONFIGURATION_ERROR; never deploy a sample secret.
AUTH_JWT_SECRET=
AUTH_COOKIE_SECURE=false
# APP_ENVIRONMENT=production also requires AUTH_COOKIE_SECURE=true.
AUTH_ENVIRONMENT=development
# JSON array of exact trusted origins. No wildcard; default denies cross-origin credentials.
AUTH_CORS_ORIGINS=[]
