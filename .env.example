# Liveness works without database settings. Set secrets only for explicit DB commands/use cases.
APP_NAME=Learning AI System API
APP_ENVIRONMENT=development
DATABASE_URL=
# Official Flyway executable (absolute path recommended). No CLI is bundled or auto-installed.
FLYWAY_EXECUTABLE=
# Opt-in disposable MySQL tests only. Never point this at an existing application database.
RUN_MYSQL_TESTS=0
TEST_DATABASE_URL=
